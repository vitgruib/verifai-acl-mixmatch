+  "Z_DIM": 16
+  "HIDDEN": 256
+  "LR": 1.0e-4
+  "GAMMA": 0.995
+  "GAE_LAMBDA": 0.98
+  "UPDATE_EPOCHS": 5
+  "NUM_MINIBATCHES": 1
+  "CLIP_EPS": 0.2
+  "ENT_COEF": 1.0e-3
+  "VF_COEF": 0.5
+  "MAX_GRAD_NORM": 0.5
