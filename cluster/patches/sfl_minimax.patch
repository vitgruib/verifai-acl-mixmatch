+# ACL27 addition: minimax adversary for single-agent JaxNav (sfl/train/jaxnav_minimax.py)
+defaults:
+  - env: jaxnav
+  - learning: ippo-jaxnav
+  - _self_
+
+"SEED": 2
+"GROUP_NAME": "jaxnav-minimax"
+"ENTITY": ""
+"PROJECT": "multi_robot_ued"
+"WANDB_MODE" : "disabled"
+"SAVE_PATH": "checkpoints/multi_robot_ued"
+"EVAL_SAMPLED_SET_PATH": "sfl/data/test_sets/sampled_tc_100e_1a.pkl"
+
+env:
+  num_agents: 1
+
+# adversary (level editor); PPO defaults are JaxUED maze_paired.py's
