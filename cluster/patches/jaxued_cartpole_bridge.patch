+# atlas patch: the ACL27 CartPole task box (acl_bench/envs/cartpole.py PARAM_BOUNDS).
+BOX = {
+    "length": (0.25, 1.5),
+    "masspole": (0.05, 0.5),
+    "masscart": (0.5, 2.0),
+    "force_mag": (4.0, 16.0),
+    "init_range": (0.05, 0.3),
+}
+
+
+def make_level_generator_box() -> Callable[[chex.PRNGKey], Level]:
+    """atlas patch: levels uniform in BOX (gravity and tau at their defaults)."""
+    lo = jnp.array([b[0] for b in BOX.values()])
+    hi = jnp.array([b[1] for b in BOX.values()])
+
+    def sample(rng: chex.PRNGKey) -> Level:
+        length, masspole, masscart, force_mag, init_range = jax.random.uniform(rng, (len(BOX),), minval=lo, maxval=hi)
+        return Level(
+            masscart=masscart,
+            masspole=masspole,
+            total_mass=masscart + masspole,
+            polemass_length=masspole * length,
+            length=length,
+            force_mag=force_mag,
+            init_range=init_range,
+        )
+    return sample
