+class ActorCriticMLP(nn.Module):
+    """atlas patch: the network of ACL27's PyTorch PPO (acl_bench/ppo.py `Agent`): separate actor and
+    critic, each two 64-unit tanh layers, orthogonal init (sqrt(2) hidden, 0.01 actor head, 1.0 critic
+    head). Layers are named after the torch state-dict entries (actor.0, actor.2, actor.4, ...)."""
+    action_dim: Sequence[int]
+
+    @nn.compact
+    def __call__(self, inputs, hidden):
+        x, _ = inputs
+
+        def mlp(name, out_dim, out_std):
+            h = x
+            for i in (0, 2):
+                h = nn.tanh(nn.Dense(LAYER_WIDTH, kernel_init=orthogonal(np.sqrt(2)), bias_init=constant(0.0), name=f"{name}_{i}")(h))
+            return nn.Dense(out_dim, kernel_init=orthogonal(out_std), bias_init=constant(0.0), name=f"{name}_4")(h)
+
+        pi = distrax.Categorical(logits=mlp("actor", self.action_dim, 0.01))
+        critic = mlp("critic", 1, 1.0)
+        return hidden, pi, jnp.squeeze(critic, axis=-1)
+
+    @staticmethod
+    def initialize_carry(batch_dims):
+        return None
+
