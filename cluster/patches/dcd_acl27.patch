+def _acl27_tile_ok(vertices, weld=0.01, min_area=1e-3):
+    """ACL27 patch: True if Box2D can build this tile polygon. b2PolygonShape::Set welds points
+    closer than ~linearSlop and needs >= 3 non-collinear hull points; near-degenerate tiles
+    (cusps in the Bezier curve) otherwise pass the Python setter and bus-error in CreateFixture."""
+    pts = []
+    for v in vertices:
+        if not all(math.isfinite(c) for c in v):
+            return False
+        if all((v[0]-q[0])**2 + (v[1]-q[1])**2 > weld*weld for q in pts):
+            pts.append(tuple(v))
+    if len(pts) < 3:
+        return False
+    pts.sort()
+    cross = lambda o, a, b: (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
+    lower, upper = [], []
+    for p in pts:
+        while len(lower) >= 2 and cross(lower[-2], lower[-1], p) <= 0: lower.pop()
+        lower.append(p)
+    for p in reversed(pts):
+        while len(upper) >= 2 and cross(upper[-2], upper[-1], p) <= 0: upper.pop()
+        upper.append(p)
+    hull = lower[:-1] + upper[:-1]
+    if len(hull) < 3:
+        return False
+    area = 0.5*abs(sum(hull[i][0]*hull[i-1][1] - hull[i-1][0]*hull[i][1] for i in range(len(hull))))
+    return area > min_area
