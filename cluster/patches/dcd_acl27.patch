diff --git a/envs/runners/sfl.py b/envs/runners/sfl.py
new file mode 100644
index 0000000..bafc2cc
--- /dev/null
+++ b/envs/runners/sfl.py
@@ -0,0 +1,134 @@
+"""ACL27 addition: Sampling For Learnability (SFL; Rutherford et al., 2024) for DCD.
+
+A port of the SFL repo's teacher (sfl/train/*_sfl.py) to DCD's runner:
+  * Every `sfl_eval_interval` updates, sample `sfl_num_eval_levels` random levels, roll the current
+    (stochastic) policy out on each for `sfl_eval_steps` agent steps, replaying the level after
+    every episode, and score it by learnability p(1-p), where p is the success rate over the
+    episodes completed in that window (0 if none completed). Success is the env's info['finish']
+    (BipedalWalker: reached the end; CarRacing: lap completed). The top `sfl_buffer_size`
+    levels replace the buffer.
+  * Each training rollout uses, per process, a uniformly sampled buffer level with probability
+    `sfl_rho` and a fresh random level otherwise (the SFL repo's 50/50 batch split).
+Evaluation steps are extra simulation that does not count toward num_env_steps; they are
+logged as `sfl_eval_steps_total`.
+"""
+import numpy as np
+import torch
+
+
+def learnability(successes, completions):
+    """p(1-p) per level; p = successes / completions, and 0 for levels with no completed episode."""
+    successes = np.asarray(successes, dtype=np.float64)
+    completions = np.asarray(completions, dtype=np.float64)
+    p = np.divide(successes, completions, out=np.zeros_like(successes), where=completions > 0)
+    return p * (1.0 - p)
+
+
+def top_k(scores, k):
+    """Indices of the k highest scores, best first (as the SFL repo's argsort)."""
+    return list(np.argsort(scores)[::-1][:k])
+
+
+def _zeros_like_hidden(h):
+    if isinstance(h, tuple):
+        return tuple(torch.zeros_like(x) for x in h)
+    return torch.zeros_like(h)
+
+
+class SFLTeacher:
+    def __init__(self, args, seed=0):
+        self.rho = args.sfl_rho
+        self.eval_interval = args.sfl_eval_interval
+        self.num_eval_levels = args.sfl_num_eval_levels
+        self.eval_steps = args.sfl_eval_steps
+        self.buffer_size = args.sfl_buffer_size
+        self.num_processes = args.num_processes
+        assert self.num_eval_levels % self.num_processes == 0, \
+            'sfl_num_eval_levels must be a multiple of num_processes'
+        assert self.buffer_size <= self.num_eval_levels
+        self.rng = np.random.RandomState(seed)
+        self.buffer = []          # levels, best first
+        self.buffer_scores = []
+        self.eval_steps_total = 0  # agent steps spent scoring levels (extra simulation)
+        self.num_evals = 0
+        self.last_stats = {}
+
+    # --- training levels ---
+    def set_training_levels(self, ued_venv):
+        """Fresh random levels, with each process swapped to a buffer level with prob. rho."""
+        ued_venv.reset_random()
+        if not self.buffer:
+            return
+        levels = list(ued_venv.get_level())
+        replay = self.rng.rand(self.num_processes) < self.rho
+        if not replay.any():
+            return
+        for i in np.flatnonzero(replay):
+            levels[i] = self.buffer[self.rng.randint(len(self.buffer))]
+        ued_venv.reset_to_level_batch(levels)
+
+    def should_evaluate(self, num_updates):
+        return num_updates % self.eval_interval == 0
+
+    # --- scoring ---
+    def _score_batch(self, agent, venv, device):
+        """Roll out on the levels currently loaded in venv; return (successes, completions)."""
+        n = self.num_processes
+        obs = venv.reset_agent()
+        hidden = _zeros_like_hidden(agent.storage.get_recurrent_hidden_state(0))
+        masks = torch.ones(n, 1, device=device)
+        successes = np.zeros(n)
+        completions = np.zeros(n)
+        for _ in range(self.eval_steps):
+            with torch.no_grad():
+                _, action, _, hidden = agent.act(obs, hidden, masks)
+            obs, _, done, infos = venv.step_env(agent.process_action(action.cpu()), reset_random=False)
+            done = np.asarray(done, dtype=bool).reshape(-1)
+            for i in np.flatnonzero(done):
+                completions[i] += 1
+                successes[i] += float(bool(infos[i].get('finish', False)))
+            masks = torch.tensor([[0.0] if d else [1.0] for d in done], device=device)
+        self.eval_steps_total += self.eval_steps * n
+        return successes, completions
+
+    def evaluate(self, agent, venv, ued_venv):
+        device = next(agent.algo.actor_critic.parameters()).device
+        levels, succ, comp = [], [], []
+        for _ in range(self.num_eval_levels // self.num_processes):
+            ued_venv.reset_random()
+            levels.extend(ued_venv.get_level())
+            s, c = self._score_batch(agent, venv, device)
+            succ.append(s)
+            comp.append(c)
+        succ, comp = np.concatenate(succ), np.concatenate(comp)
+        scores = learnability(succ, comp)
+        keep = top_k(scores, self.buffer_size)
+        self.buffer = [levels[i] for i in keep]
+        self.buffer_scores = [float(scores[i]) for i in keep]
+        self.num_evals += 1
+        p = np.divide(succ, comp, out=np.zeros_like(succ), where=comp > 0)
+        self.last_stats = {
+            'sfl_num_evals': self.num_evals,
+            'sfl_eval_steps_total': self.eval_steps_total,
+            'sfl_buffer_mean_learnability': float(np.mean(self.buffer_scores)),
+            'sfl_sampled_mean_learnability': float(np.mean(scores)),
+            'sfl_sampled_mean_success': float(np.mean(p)),
+            'sfl_sampled_frac_completed': float(np.mean(comp > 0)),
+        }
+        return self.last_stats
+
+    def stats(self):
+        return dict(self.last_stats)
+
+    def state_dict(self):
+        return {'buffer': self.buffer, 'buffer_scores': self.buffer_scores,
+                'eval_steps_total': self.eval_steps_total, 'num_evals': self.num_evals,
+                'rng': self.rng.get_state(), 'last_stats': self.last_stats}
+
+    def load_state_dict(self, d):
+        self.buffer = d['buffer']
+        self.buffer_scores = d['buffer_scores']
+        self.eval_steps_total = d['eval_steps_total']
+        self.num_evals = d['num_evals']
+        self.rng.set_state(d['rng'])
+        self.last_stats = d['last_stats']
