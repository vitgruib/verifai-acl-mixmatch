diff --git a/envs/box2d/soft_render.py b/envs/box2d/soft_render.py
new file mode 100644
index 0000000..55944f9
--- /dev/null
+++ b/envs/box2d/soft_render.py
@@ -0,0 +1,148 @@
+"""ACL27 patch: window-free software renderer for CarRacingBezier (enabled by ACL27_SOFT_RENDER=1).
+
+Reproduces CarRacingBezier.render() for the array modes without OpenGL, so CarRacing can be
+smoke-tested on machines with no display (and without creating any window, hidden or not).
+GL draws the 1000x800 window into a VP_W x VP_H viewport, i.e. it rescales the whole window;
+we rasterise the same polygons with PIL at 4x supersampling and sample pixel centres.
+Known difference: the white score digits in the bottom-left corner are not drawn.
+Cluster training does not use this; it keeps the real pyglet renderer under xvfb-run.
+"""
+import math
+import sys
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+SS = 4  # supersampling factor
+
+
+class _Recorder:
+    """Stands in for rendering.Viewer so gym's Car.draw() records its polygons."""
+    def __init__(self):
+        self.polys = []
+
+    def draw_polygon(self, v, color=(0, 0, 0), **kw):
+        self.polys.append(([tuple(p) for p in v], color))
+
+    def draw_polyline(self, v, **kw):  # particles; only drawn in 'human'/'rgb_array'
+        pass
+
+
+def _mod(env):
+    """The env's own module: car_racing_bezier, or car_racing (CarRacing-Vanilla, a test env)."""
+    for cls in type(env).__mro__:  # CarRacingF1 subclasses CarRacingBezier from another module
+        m = sys.modules.get(cls.__module__)
+        if m is not None and hasattr(m, 'ZOOM') and hasattr(m, 'WINDOW_W'):
+            return m
+    raise TypeError(f'soft_render: no CarRacing constants for {type(env)}')
+
+
+def _road_quads(env):
+    """Background, grass checkerboard and road tiles, in world coordinates (as render_road)."""
+    pf = getattr(env, 'playfield', None) or _mod(env).PLAYFIELD
+    quads = [([(pf, pf), (pf, -pf), (-pf, -pf), (-pf, pf)], (0.4, 0.8, 0.4))]
+    k = pf / 20.0
+    for x in range(-20, 20, 2):
+        for y in range(-20, 20, 2):
+            quads.append(([(k*x + k, k*y), (k*x, k*y), (k*x, k*y + k), (k*x + k, k*y + k)],
+                          (0.4, 0.9, 0.4)))
+    for poly, color in env.road_poly:
+        quads.append(([tuple(p) for p in poly], tuple(color[:3])))
+    return quads
+
+
+def _transform(env, mode):
+    """(zoom, angle, tx, ty) exactly as the env's render() computes them."""
+    crb = _mod(env)
+    birdseye = getattr(env, 'birdseye', False)
+    zoom_coef = env.full_zoom if (birdseye or mode in ['level', 'sketch']) else crb.ZOOM
+    if getattr(env, 'animate_zoom', False):
+        zoom = 0.1*crb.SCALE*max(1 - env.t, 0) + zoom_coef*crb.SCALE*min(env.t, 1)
+    else:
+        zoom = zoom_coef*crb.SCALE
+    sx, sy = env.car.hull.position[0], env.car.hull.position[1]
+    angle = -env.car.hull.angle
+    vel = env.car.hull.linearVelocity
+    if np.linalg.norm(vel) > 0.5:
+        angle = math.atan2(vel[0], vel[1])
+    if birdseye or mode in ['level', 'sketch']:
+        return zoom, 0.0, crb.WINDOW_W/2, crb.WINDOW_H/2
+    tx = crb.WINDOW_W/2 - (sx*zoom*math.cos(angle) - sy*zoom*math.sin(angle))
+    ty = crb.WINDOW_H/4 - (sx*zoom*math.sin(angle) + sy*zoom*math.cos(angle))
+    return zoom, angle, tx, ty
+
+
+def _indicators(env):
+    """render_indicators(), in window coordinates (no transform), minus the score label."""
+    W, H = _mod(env).WINDOW_W, _mod(env).WINDOW_H
+    s, h = W/40.0, H/40.0
+    quads = [([(W, 0), (W, 5*h), (0, 5*h), (0, 0)], (0, 0, 0))]
+
+    def vertical(place, val, color):
+        quads.append(([(place*s, h + h*val), ((place + 1)*s, h + h*val),
+                       ((place + 1)*s, h), (place*s, h)], color))
+
+    def horiz(place, val, color):
+        quads.append(([(place*s, 4*h), ((place + val)*s, 4*h),
+                       ((place + val)*s, 2*h), (place*s, 2*h)], color))
+
+    car = env.car
+    true_speed = np.sqrt(np.square(car.hull.linearVelocity[0]) + np.square(car.hull.linearVelocity[1]))
+    vertical(5, 0.02*true_speed, (1, 1, 1))
+    vertical(7, 0.01*car.wheels[0].omega, (0.0, 0, 1))
+    vertical(8, 0.01*car.wheels[1].omega, (0.0, 0, 1))
+    vertical(9, 0.01*car.wheels[2].omega, (0.2, 0, 1))
+    vertical(10, 0.01*car.wheels[3].omega, (0.2, 0, 1))
+    horiz(20, -10.0*car.wheels[0].joint.angle, (0, 1, 0))
+    horiz(30, -0.8*car.hull.angularVelocity, (1, 0, 0))
+    return quads
+
+
+def _rgb(color):
+    return tuple(int(round(255*min(max(c, 0.0), 1.0))) for c in color[:3])
+
+
+def render(env, mode):
+    if mode == 'human':
+        raise RuntimeError('ACL27_SOFT_RENDER is set: human mode would need a window')
+    if 't' not in env.__dict__:
+        return None  # reset() not called yet
+    crb = _mod(env)
+    if mode == 'rgb_array':
+        vw, vh = crb.VIDEO_W, crb.VIDEO_H
+    elif mode in ['state_pixels', 'sketch']:
+        vw, vh = crb.STATE_W, crb.STATE_H
+    else:  # 'level': the whole window
+        vw, vh = crb.WINDOW_W, crb.WINDOW_H
+    ss = SS if max(vw, vh) <= crb.VIDEO_W else 1
+    fx, fy = vw*ss/crb.WINDOW_W, vh*ss/crb.WINDOW_H  # window -> supersampled pixels
+
+    zoom, angle, tx, ty = _transform(env, mode)
+    c, s = math.cos(angle), math.sin(angle)
+
+    rec = _Recorder()
+    env.car.draw(rec, mode != 'state_pixels')
+    world = _road_quads(env) + rec.polys
+
+    img = Image.new('RGB', (vw*ss, vh*ss), (0, 0, 0))
+    draw = ImageDraw.Draw(img)
+    W, H = vw*ss, vh*ss
+
+    def fill(window_pts, color):
+        px = [(x*fx, H - y*fy) for x, y in window_pts]
+        xs, ys = [p[0] for p in px], [p[1] for p in px]
+        if max(xs) < 0 or min(xs) > W or max(ys) < 0 or min(ys) > H:
+            return
+        draw.polygon(px, fill=_rgb(color))
+
+    for pts, color in world:
+        win = [(tx + zoom*(c*x - s*y), ty + zoom*(s*x + c*y)) for x, y in pts]
+        fill(win, color)
+    if mode not in ['level', 'sketch'] and getattr(env, 'show_indicators', True):
+        for pts, color in _indicators(env):
+            fill(pts, color)
+
+    arr = np.asarray(img, dtype=np.uint8)
+    if ss > 1:
+        arr = arr[ss//2::ss, ss//2::ss]
+    return np.ascontiguousarray(arr)
